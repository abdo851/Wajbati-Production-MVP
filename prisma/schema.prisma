generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CUSTOM_DATABASE_URL")
}

enum Role {
  CUSTOMER
  CHEF
  DRIVER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  ACCEPTED
  DELIVERED
  CANCELLED
  REFUSED
  NOT_REACHABLE
}

enum WalletTxnType {
  TOPUP
  COMMISSION
  PENALTY
}

model User {
  id                    String         @id
  email                 String         @unique
  phone                 String?        @unique
  password              String
  fullName              String         @default("")
  role                  Role
  walletBalance         Float          @default(0) @map("wallet_balance")
  approvalStatus        ApprovalStatus @default(PENDING) @map("approval_status")
  emailConfirmed        Boolean        @default(false) @map("email_confirmed")
  signatureUrl          String?        @map("signature_url") @db.Text
  googleSub             String?        @unique
  confirmationToken     String?
  confirmationExpiresAt DateTime?
  avatarDataUrl         String?        @db.Text
  isActive              Boolean        @default(true)
  isDeleted             Boolean        @default(false) @map("is_deleted")
  createdAt             DateTime       @default(now()) @map("created_at")

  chefProfile      ChefProfile?
  driverProfile    DriverProfile?
  transactions     WalletTransaction[]
  sentMessages     Message[]           @relation("SentMessages")
  receivedMessages Message[]           @relation("ReceivedMessages")
  following        Follow[]            @relation("CustomerFollows")
  followers        Follow[]            @relation("ChefFollowers")
}

model ChefProfile {
  id                     String    @id
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                    String?   @db.Text
  city                   String?
  avatarUrl              String?   @map("avatar_url") @db.Text
  kitchenName            String    @default("")
  cinStoragePath         String?
  autoEntrepreneurNumber String?
  foodSafetyAcceptedAt   DateTime?
  kitchenPhotoDataUrl    String?   @db.Text
  gallery                String[]  @default([])
  averageRating          Float     @default(0) @map("average_rating")
  postponedAt            DateTime?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now()) @map("created_at")
}

model Follow {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation("CustomerFollows", fields: [customerId], references: [id], onDelete: Cascade)
  chefId     String
  chef       User     @relation("ChefFollowers", fields: [chefId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, chefId])
  @@index([customerId])
  @@index([chefId])
}

model DriverProfile {
  id                  String    @id
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType         String    @map("vehicle_type")
  licenseUrl          String?   @map("license_url") @db.Text
  city                String?
  notes               String?   @db.Text
  vehiclePhotoDataUrl String?   @db.Text
  gallery             String[]  @default([])
  postponedAt         DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
}

model Meal {
  id                String   @id
  chefId            String
  title             String
  description       String       @db.Text
  price             Float
  quantity          Int
  remainingQuantity Int          @map("remaining_quantity")
  isPublished       Boolean      @map("is_published")
  serviceDate       DateTime     @map("service_date") @db.Date
  imageUrl          String?      @map("image_url")
  images            String[]     @default([])
  isDeleted         Boolean      @default(false) @map("is_deleted")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  orders            Order[]
}

model Order {
  id                   String      @id
  customerId           String?
  driverId             String?
  mealId               String
  meal                 Meal        @relation(fields: [mealId], references: [id], onDelete: Restrict)
  chefId               String
  quantity             Int
  status               OrderStatus
  flowStatus           String
  otpCode              String      @map("otp_code")
  otpHash              String?
  otpExpiry            DateTime?
  otpAttempts          Int         @default(0)
  refuseReason         String?
  address              String
  deliveryLat          Float?
  deliveryLng          Float?
  notes                String?
  totalPrice           Float       @map("total_price")
  customerName         String
  customerPhone        String
  unitPriceMad         Float
  commissionPerMealMad Float
  commissionMad        Float
  deliveryFeeMad       Float
  driverCommissionMad  Float
  chefServiceFee       Float?
  driverCommission     Float?
  customerEmail        String?
  paymentMethod        String
  paymentStatus        String
  trackToken           String      @unique
  rating               Int?
  review               String?     @db.Text
  isDeleted            Boolean     @default(false) @map("is_deleted")
  isActive             Boolean     @default(true) @map("is_active")
  createdAt            DateTime    @default(now()) @map("created_at")

  @@index([customerPhone])
  @@index([chefId])
}

model WalletTransaction {
  id          String        @id
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        WalletTxnType
  note        String
  referenceId String?       @map("reference_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([userId])
}

model Message {
  id         String   @id
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  threadId   String
  mealId     String?
  orderId    String?
  customerId String?
  senderRole String
  senderName String

  @@index([threadId])
}

model SupportMessage {
  id              String   @id
  threadId        String
  participantRole String
  participantName String
  sender          String
  body            String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([threadId])
}

model StoredFile {
  id          String   @id
  ownerId     String
  ownerKind   String
  kind        String
  contentType String
  storagePath String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ownerId, ownerKind])
}

model EmailCapture {
  id        String   @id @default(cuid())
  email     String
  source    String
  createdAt DateTime @default(now()) @map("created_at")
}

model PlatformSetting {
  id                  String @id @default("default")
  chefCommissionMad   Float  @default(1)
  driverCommissionMad Float  @default(1)
}

/// Operational tables — migration prepared but not applied in Phase 2.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

model OrderStatusEvent {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String
  toStatus   String
  actorRole  String
  actorId    String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}

/// Marketplace Phase 2 — independent of Meal / order-linked SecureChat.
/// Apply only on an isolated localhost test database.

enum ListingKind {
  PERMANENT
  TEMPORARY
}

enum ListingPriceMode {
  FIXED
  NEGOTIABLE
  HIDDEN
}

enum ListingAvailability {
  AVAILABLE
  PREORDER
  UNAVAILABLE
  SOLD_OUT
}

enum ListingModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model MarketplaceListing {
  id                   String                  @id
  chefProfileId        String                  @map("chef_profile_id")
  sellerUserId         String                  @map("seller_user_id")
  title                String
  description          String                  @db.Text
  category             String                  @default("home")
  images               String[]                @default([])
  kind                 ListingKind             @default(PERMANENT)
  priceMode            ListingPriceMode        @map("price_mode")
  priceMad             Float?                  @map("price_mad")
  availability         ListingAvailability     @default(AVAILABLE)
  isPublished          Boolean                 @default(false) @map("is_published")
  moderationStatus     ListingModerationStatus @default(PENDING) @map("moderation_status")
  moderationReason     String?                 @map("moderation_reason") @db.Text
  previouslyApprovedAt DateTime?               @map("previously_approved_at")
  city                 String                  @default("")
  neighborhood         String                  @default("")
  expiresAt            DateTime?               @map("expires_at")
  isDeleted            Boolean                 @default(false) @map("is_deleted")
  isActive             Boolean                 @default(true) @map("is_active")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@index([chefProfileId])
  @@index([sellerUserId])
  @@index([city])
  @@index([city, neighborhood])
  @@index([isPublished, moderationStatus, availability])
  @@index([expiresAt])
}

model MarketplaceConversation {
  id           String   @id
  buyerUserId  String   @map("buyer_user_id")
  sellerUserId String   @map("seller_user_id")
  listingId    String?  @map("listing_id")
  lastMessageAt DateTime? @map("last_message_at")
  buyerUnread  Int      @default(0) @map("buyer_unread")
  sellerUnread Int      @default(0) @map("seller_unread")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  messages     MarketplaceMessage[]

  @@unique([buyerUserId, sellerUserId])
  @@index([buyerUserId])
  @@index([sellerUserId])
}

model MarketplaceMessage {
  id             String   @id
  conversationId String   @map("conversation_id")
  conversation   MarketplaceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String   @map("sender_user_id")
  body           String   @db.Text
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

model SellerPresence {
  sellerUserId         String   @id @map("seller_user_id")
  lastSeenAt           DateTime @map("last_seen_at")
  /// Seller willingness to receive inquiries — independent of live heartbeat presence.
  acceptingInquiries   Boolean  @default(true) @map("accepting_inquiries")
  updatedAt            DateTime @updatedAt @map("updated_at")
}

model AppNotification {
  id        String   @id
  userId    String   @map("user_id")
  kind      String
  title     String
  body      String   @db.Text
  href      String?
  readAt    DateTime? @map("read_at")
  dedupeKey String?  @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@unique([userId, dedupeKey])
}

model ListingReport {
  id               String    @id
  listingId        String    @map("listing_id")
  reporterUserId   String    @map("reporter_user_id")
  reason           String    @db.Text
  description      String?   @db.Text
  category         String    @default("general")
  priority         String    @default("normal")
  status           String    @default("open")
  assignedAdminId  String?   @map("assigned_admin_id")
  assignedAt       DateTime? @map("assigned_at")
  decisionType     String?   @map("decision_type")
  decisionReason   String?   @map("decision_reason") @db.Text
  decidedByAdminId String?   @map("decided_by_admin_id")
  decidedAt        DateTime? @map("decided_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  notes            ModerationCaseNote[]
  events           ModerationCaseEvent[]
  messages         ModerationCaseMessage[]

  @@index([listingId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([assignedAdminId])
}

/// Admin-only investigation notes for a listing report case.
model ModerationCaseNote {
  id            String   @id
  reportId      String   @map("report_id")
  report        ListingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorAdminId String   @map("author_admin_id")
  body          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([reportId, createdAt])
}

/// Authoritative investigation timeline for a listing report case.
model ModerationCaseEvent {
  id        String   @id
  reportId  String   @map("report_id")
  report    ListingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId   String?  @map("actor_id")
  actorRole String   @map("actor_role")
  eventType String   @map("event_type")
  summary   String   @db.Text
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId, createdAt])
}

/// Case-scoped two-way messaging (not Marketplace inbox).
model ModerationCaseMessage {
  id              String    @id
  reportId        String    @map("report_id")
  report          ListingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  senderUserId    String    @map("sender_user_id")
  senderRole      String    @map("sender_role")
  recipientUserId String    @map("recipient_user_id")
  body            String    @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  readAt          DateTime? @map("read_at")

  @@index([reportId, createdAt])
}
