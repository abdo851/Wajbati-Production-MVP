# local uses data/store.json and the demo kitchens.
# Set DATA_PROVIDER=supabase after applying supabase/migrations.
DATA_PROVIDER=local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required when NODE_ENV=production. Local dev has a built-in fallback.
WAJBATI_SESSION_SECRET=

# Optional. Enables the Google button for chefs, drivers, and customer profiles.
# In Supabase mode, also enable the Google provider in Authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
