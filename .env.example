# local uses data/store.json and the demo kitchens.
# Set DATA_PROVIDER=supabase after applying supabase/migrations.
DATA_PROVIDER=local

# Prisma PostgreSQL URL (preferred). Keep DATA_PROVIDER=local for the Prisma repository.
# Deployment (Vercel) sets this to the production project. Do not point ordinary local
# `npm run dev` at production — use .env.test.local + the isolated Docker DB instead.
CUSTOM_DATABASE_URL=

# Isolated local Marketplace / auth test database (required for `npm run dev`).
# Put the real value in gitignored `.env.test.local` (not here).
# Expected shape: localhost / 127.0.0.1 port 55432 database righ_test.
# RIGH_TEST_DATABASE_URL=postgresql://righ_test:****@127.0.0.1:55432/righ_test

# Local Prisma writes to one approved Supabase Postgres project only (project ref, not a URL).
# Example: RIGH_APPROVED_SUPABASE_PROJECT_REF=yourprojectref
# Never set RIGH_ALLOW_SHARED_DB_WRITES=1 for this transition.
# Ordinary local `npm run dev` clears this opt-in and forces the isolated test DB.
RIGH_APPROVED_SUPABASE_PROJECT_REF=

# Opt-in only: allow demo seed()/store.json bootstrap into a localhost DB.
# Never enable against Supabase/Neon. Default is unset (no auto-seed).
# RIGH_ALLOW_DEMO_SEED=1

# Temporary LOCAL admin UI preview only (never set on Vercel).
# Requires NODE_ENV=development AND isolated DB 127.0.0.1:55432/righ_test via `npm run dev`.
# Alias: RIGH_ALLOW_ADMIN_BYPASS=1
# RIGH_LOCAL_ADMIN_PREVIEW=1

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required when NODE_ENV=production. Local dev has a built-in fallback.
WAJBATI_SESSION_SECRET=

# Optional. Enables the Google button for chefs, drivers, and customer profiles.
# In Supabase mode, also enable the Google provider in Authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
