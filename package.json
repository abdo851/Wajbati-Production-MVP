{
  "name": "wajbati",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-isolated.mjs",
    "dev:local": "node scripts/dev-isolated.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:isolated:check": "node -e \"import('./scripts/lib/isolated-local-db.mjs').then(m=>{const meta=m.applyIsolatedLocalDatabaseEnv(); console.log(JSON.stringify({ok:true,hostKind:meta.hostKind,host:meta.host,port:meta.port,database:meta.database,refMatchesPrimary:meta.refMatchesPrimary}))}).catch(e=>{console.error(e.message); process.exit(1)})\"",
    "db:migrate:isolated": "node scripts/run-with-isolated-db.mjs -- npx prisma migrate deploy",
    "test:unit": "node --experimental-strip-types --import ./tests/register-alias.mjs --test tests/unit/*.test.mjs",
    "test:integration": "node --experimental-strip-types --import ./tests/register-alias.mjs --test --test-concurrency=1 tests/integration/*.test.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "framer-motion": "^14.14.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.1",
    "signature_pad": "^5.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.65.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "engines": {
    "node": "24.x"
  }
}
